# Supabase → Project Settings → API (or the "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: lets you change the profile picture from the app. Server-only, never NEXT_PUBLIC_.
# Supabase → Project Settings → API Keys → secret key (or the legacy service_role key)
SUPABASE_SECRET_KEY=your-secret-key
# Any passcode you choose (6+ characters); you type it when changing the picture
OWNER_PASSCODE=choose-a-passcode
